{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CEGAR proposed finite-model input (untrusted supplied graph)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bit_width",
    "states",
    "initial",
    "bad",
    "transitions"
  ],
  "properties": {
    "bit_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "initial": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "bad": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/transition"
      }
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "action"
      ],
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
