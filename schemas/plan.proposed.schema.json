{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CEGAR proposed candidate plan (not trusted; cannot grant authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_domain",
    "snapshot_ref",
    "policy_ref",
    "tool_registry_ref",
    "artifacts",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-proposal"
    },
    "task_domain": {
      "const": "artifact-publish"
    },
    "snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "tool_registry_ref": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "digest"
        ],
        "properties": {
          "kind": {
            "enum": [
              "base",
              "patch",
              "candidate",
              "test_attestation"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "depends_on",
        "inputs",
        "output"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "tool": {
          "enum": [
            "stage_patch",
            "run_registered_tests",
            "publish"
          ]
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 127,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
